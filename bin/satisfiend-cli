#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Satisfiend command-line utility.
 *
 * See `satisfiend-cli help` for available subcommands.
 *
 * Copyright 2026 The Horde Project (http://www.horde.org/)
 *
 * See the enclosed file LICENSE for license information (LGPL). If you
 * did not receive this file, see http://www.horde.org/licenses/lgpl21.
 */

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "This tool must be run from the command line.\n");
    exit(1);
}

// Composer proxies bin scripts through a small wrapper that sets
// $GLOBALS['_composer_autoload_path'] to the correct autoloader for
// the installation. When present (i.e. when the CLI was invoked
// through vendor/bin/satisfiend-cli or the composer-generated proxy),
// prefer it - it always points at the running install's autoloader,
// even when this script lives elsewhere on disk via a symlink.
//
// Fallbacks handle the two other shapes:
//   - satisfiend as a dependency of a running horde install, invoked
//     directly via vendor/horde/satisfiend/bin/satisfiend-cli
//     (autoload lives four levels up);
//   - a standalone clone with a local vendor dir (dev use only,
//     autoload lives two levels up).
$autoloadCandidates = [];
if (isset($GLOBALS['_composer_autoload_path']) && is_string($GLOBALS['_composer_autoload_path'])) {
    $autoloadCandidates[] = $GLOBALS['_composer_autoload_path'];
}
$autoloadCandidates[] = __DIR__ . '/../../../autoload.php';
$autoloadCandidates[] = __DIR__ . '/../vendor/autoload.php';

foreach ($autoloadCandidates as $autoloadPath) {
    if (is_file($autoloadPath)) {
        require_once $autoloadPath;
        break;
    }
}

if (!class_exists(\Horde\Satisfiend\Cli\BootstrapCli::class)) {
    fwrite(STDERR, "satisfiend-cli: could not locate composer autoloader\n");
    exit(2);
}

exit(\Horde\Satisfiend\Cli\BootstrapCli::build()->run($argv));
